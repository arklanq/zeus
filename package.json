{
  "name": "zeus",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.4.x"
  },
  "scripts": {
    "build": "bun run src/build.ts",
    "build:check": "bun run src/build.ts --check",
    "build:binary": "bun run build && bun run src/build-release.ts --host",
    "release:build": "bun run build && bun run src/build-release.ts",
    "test": "bun test ./tests",
    "test:dashboard": "node --test skills/dashboard/tests/runtime.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run build:check && bun run test && bun run test:dashboard && bash -n install.sh",
    "catalog:update": "bun run src/update-catalog.ts",
    "zeus:install": "bun run build:binary && ./release/zeus install",
    "zeus:uninstall": "${ZEUS_BIN_DIR:-$HOME/.local/bin}/zeus uninstall"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "jsonc-parser": "3.3.1"
  }
}
